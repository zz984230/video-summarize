{
  "manifest_version": 3,
  "name": "B站视频摘要助手",
  "version": "2.0.0",
  "description": "基于多模态模型的B站视频智能摘要分析工具",
  
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "contextMenus"
  ],
  
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://api-inference.modelscope.cn/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/video/*"],
      "js": ["services/error-handler.js", "content/content.js"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站视频摘要助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["services/*.js"],
      "matches": ["*://*.bilibili.com/*"]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}