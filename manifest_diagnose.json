{
  "manifest_version": 3,
  "name": "B站视频摘要助手 - 诊断版",
  "version": "1.0.0",
  "description": "诊断 content.js 加载问题",
  
  "permissions": [
    "activeTab",
    "storage"
  ],
  
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站视频摘要助手"
  },
  
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}